{
  "name": "@proslides/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../api/openapi/openapi.yaml -o src/shared/api/generated/openapi.ts",
    "api:types:check": "node scripts/check-openapi-types.mjs",
    "dev": "vite",
    "build": "node scripts/update-sitemap.mjs && vite build && npm run bundle:check",
    "bundle:check": "node scripts/check-bundle-budgets.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "architecture:check": "node scripts/check-frontend-architecture.mjs",
    "test:component": "vitest run --config vitest.config.ts",
    "test:component:typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.15.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.9.5",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.11.25",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.6",
    "shadcn": "^3.4.2",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.41.0",
    "vite": "npm:rolldown-vite@^7.1.14",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "vitest": "5.0.1"
  }
}

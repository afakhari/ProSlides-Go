{
  "name": "@proslides/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript ../api/openapi/openapi.yaml -o src/shared/api/generated/openapi.ts",
    "api:types:check": "node scripts/check-openapi-types.mjs",
    "dev": "vite",
    "build": "node scripts/update-sitemap.mjs && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "node --test tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@shadcn/ui": "^0.0.4",
    "@tailwindcss/vite": "^4.1.15",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "emoji-picker-react": "^4.15.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.5",
    "shadcn-ui": "^0.9.5",
    "tailwind-merge": "^3.3.1",
    "tailwind-variants": "^3.1.1",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.10.1",
    "postcss": "^8.5.6",
    "shadcn": "^3.4.2",
    "tailwindcss": "^4.1.15",
    "typescript": "^5.9.3",
    "vite": "npm:rolldown-vite@^7.1.14"
